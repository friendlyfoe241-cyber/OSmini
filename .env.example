# --- Supabase (client-safe values) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER expose to the browser) ---
# Required for automation scheduler and invitation flows.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron authentication ---
# Secret that must be sent as `Authorization: Bearer <CRON_SECRET>` by the
# scheduler hitting /api/cron (e.g. Supabase scheduled Edge Function or
# an external cron service). Generate a long random string.
CRON_SECRET=

# --- Gemini API credentials (server-only) ---
# Multiple keys enable graceful failover between credentials you control.
# This is for redundancy between your own Google AI Studio projects —
# it must NOT be used to bypass Google quotas or limits.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Gemini models (server-only, optional — defaults are used when empty) ---
AI_MODEL_FAST=gemini-2.0-flash
AI_MODEL_REASONING=gemini-2.0-flash
AI_MODEL_SUMMARY=gemini-2.0-flash

# --- AI tuning (server-only, optional) ---
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2048
